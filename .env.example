# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value below is the built-in default unless
# marked otherwise, so an empty file is a valid (development) configuration.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (required) -----------------------------------------------------
# Local docker compose Postgres. On Neon/Render, see the two variables below.
DATABASE_URL=postgres://variant:variant@localhost:55432/variant
# On Neon: keep DATABASE_URL as the *pooled* string (hostname contains -pooler) for
# query traffic, and set this to the *direct* string (no -pooler) for the config
# listener, which needs a real session for LISTEN/NOTIFY. This is the same variable
# name `neon env pull` writes. Optional; falls back to DATABASE_URL.
DB_POOL_MAX=20
# Server-side statement timeout. A runaway analytics query cannot hold a pool
# connection open indefinitely and starve the assignment path.
DB_STATEMENT_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_MS=3000

# --- Config cache ------------------------------------------------------------
# How long a snapshot is served before a refresh is attempted.
CONFIG_TTL_MS=5000
# How long a snapshot is still served after refreshes start failing. Deliberately
# long: a slightly stale split is better than breaking customer pages.
CONFIG_MAX_STALE_MS=3600000

# --- Request budgets ---------------------------------------------------------
# Whole-request budget for /v1/assign, including a cold cache's first load.
ASSIGNMENT_DEADLINE_MS=150
# How long /v1/track waits for a durable write before queueing for retry.
TRACK_WRITE_TIMEOUT_MS=750
TRACK_QUEUE_MAX=50000
TRACK_RETRY_INTERVAL_MS=2000

# --- Control plane -----------------------------------------------------------
# REQUIRED in production; the service refuses to boot without it. Use a long
# random string. Rotating it invalidates all outstanding admin sessions.
ADMIN_TOKEN=change-me

# --- LLM content generation (control plane only) ------------------------------
# `none` disables generation and requires creatives to be supplied explicitly.
# The serving path never calls the provider.
LLM_PROVIDER=none
# Required unless LLM_PROVIDER=none or ollama.
LLM_API_KEY=
# Anthropic: claude-sonnet-4-5 | claude-opus-4-1 | claude-haiku-4-5
# OpenAI:   gpt-4.1 | gpt-4.1-mini | ollama: gemma4:31b-cloud
LLM_MODEL=
# Only used by the ollama provider.
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_MS=20000
LLM_MAX_CANDIDATES=3

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
# Public origin of the deployment, used in dashboard links.
PUBLIC_BASE_URL=
